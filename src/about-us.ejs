<!DOCTYPE html>

<html lang="pl">
<head>
    <title data-i18n="about.title"></title>
    <meta name="description" data-i18n-attr="[content]about.meta.description"/>
    
    <%- include('templates/meta.ejs') %>
    
</head>
<body>
<%- include('templates/header.ejs') %>

<section class="simple-section about-us-page">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark border-bottom">
          <h2 data-i18n="about.pageTitle"></h2>
        </div>
        <div class="row about-us-page-row">
            <div class="col-12 col-lg-6">
                <div class="about-us-page__text">
                    <h3 class="simple-section__subtitle subtitle-left" data-i18n="about.history.title"></h3>
                    <p class="accent-text-block left">
                        <span data-i18n="about.history.text.1Peace"></span> <b class="no-wrap">Weld Tech Group</b> 
                        <span data-i18n="about.history.text.2Peace"></span><br>

                        <span data-i18n="about.history.text.3Peace"></span> <b class="no-wrap">ISO 3834 – 2,1090-1034</b> 
                        <span data-i18n="about.history.text.4Peace"></span><br>

                        <span data-i18n="about.history.text.5Peace"></span>
                    </p>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="about-us-page__video shadow-video right">
                    <video width="100%" height="100%" autoplay muted loading="lazy">
                    <source src="/assets/img/IMFZ6564.webm" type="video/webm">
                    <source src="/assets/img/IMFZ6564.MP4" type="video/mp4">
                        <span data-i18n="about.video.notSupported"></span>
                    </video>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="simple-section values light-image-bg">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark border-bottom values-heading">
            <h2 data-i18n="about.values.title"></h2>
        </div>
        <div class="row">
            <div class="col-12 col-md-6 values-item-wrap">
                <div class="values-item accent-text-block all">
                    <div class="values-item__title">
                        <h2 class="gradient-number animate-on-scroll zoom-In">1</h2>
                        <h3 data-i18n="about.values.items.quality.title"></h3>
                    </div>
                    <div class="values-item__text" data-i18n="about.values.items.quality.text"></div>
                </div>
            </div>

            <div class="col-12 col-md-6 values-item-wrap">
                <div class="values-item accent-text-block all">
                    <div class="values-item__title">
                        <h2 class="gradient-number animate-on-scroll zoom-In">2</h2>
                        <h3 data-i18n="about.values.items.teamwork.title"></h3>
                    </div>
                    <div class="values-item__text" data-i18n="about.values.items.teamwork.text"></div>
                </div>
            </div>

            <div class="col-12 col-md-6 values-item-wrap">
                <div class="values-item accent-text-block all">
                    <div class="values-item__title">
                        <h2 class="gradient-number animate-on-scroll zoom-In">3</h2>
                        <h3 data-i18n="about.values.items.customer.title"></h3>
                    </div>
                    <div class="values-item__text" data-i18n="about.values.items.customer.text"></div>
                </div>
            </div>

            <div class="col-12 col-md-6 values-item-wrap">
                <div class="values-item accent-text-block all">
                    <div class="values-item__title">
                        <h2 class="gradient-number animate-on-scroll zoom-In">4</h2>
                        <h3 data-i18n="about.values.items.responsibility.title"></h3>
                    </div>
                    <div class="values-item__text" data-i18n="about.values.items.responsibility.text"></div>
                </div>
            </div>

            <div class="col-12 col-md-6 values-item-wrap">
                <div class="values-item accent-text-block all">
                    <div class="values-item__title">
                        <h2 class="gradient-number animate-on-scroll zoom-In">5</h2>
                        <h3 data-i18n="about.values.items.improvement.title"></h3>
                    </div>
                    <div class="values-item__text" data-i18n="about.values.items.improvement.text"></div>
                </div>
            </div>
        </div>
        <div class="values-bottom-text">
            <h4 data-i18n="about.values.bottomText"></h4>
            <div class="btn-group-nowrap">
                <span class="arrow arrow-right arrow-dark animate-on-scroll"></span>
                <a href="<%= path('our-services.html') %>" class="simple-button" data-i18n="common.buttons.services"></a>
                <span class="arrow arrow-left arrow-dark animate-on-scroll"></span>
            </div>
        </div>
    </div>
    
</section>

<%- include('templates/stuff.ejs') %>

<%- include('templates/certificates.ejs') %>

<%- include('templates/footer.ejs') %>

</body>
</html>