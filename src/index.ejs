<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="home.title"></title>
    <meta name="description" data-i18n-attr="[content]home.meta.description" />
        <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]home.title">
    <meta property="og:description" data-i18n-attr="[content]home.meta.description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMain.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">

    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]home.title">
    <meta name="twitter:description" data-i18n-attr="[content]home.meta.description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMain.jpg">

    <%- include('templates/meta.ejs') %>
    
</head>
<body class="home">
  <%- include('templates/header.ejs') %>

<section id="welcome" class="welcome">
  <div class="welcome-banner">
    <div class="container-md container-xxl h-100 welcome-banner-container">
      <div class="row align-items-center welcome-heading-wrap">
        <div class="welcome-heading">
          <h1 data-i18n="home.hero.title"></h1>
          <h6 data-i18n="home.hero.subtitle"></h6>
          <h4 data-i18n="home.hero.description"></h4>
            <div class="welcome-heading__buttons">
              <a href="<%= path('about-us.html') %>" class="simple-button" data-i18n="common.buttons.more"></a>
              <a href="#contacts" class="simple-button" data-i18n="common.buttons.contact"></a>
            </div>
        </div>
      </div>
    </div> 

      <div class="welcome-video">
        <video width="100%" height="100%" autoplay muted loop loading="lazy">
          <source src="/assets/video/Weld-tech-video.webm" type="video/webm">
          <source src="/assets/video/Weld-tech-video.mp4" type="video/mp4">
          <span data-i18n="home.video.notSupported"></span>
        </video>
      </div>
    
  </div>
  
  <div class="welcome-text-wrap">
    <div class="container-md container-xxl h-100">
      <div class="row align-items-center h-100">
        <div class="col-12 col-md-11 col-lg-7 col-xl-8 row align-items-center">
          <div class="welcome-text">
            <h3 class="subtitle-left" data-i18n="home.experience.title"></h3>
            <p class="accent-text-block left" data-i18n="home.experience.description"></p>
            <span class="arrow arrow-down arrow-dark animate-on-scroll"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="about-us" class="simple-section about-us">
  <div class="container-md container-xxl h-100">
    <div class="row">
      <div class="col-12 col-md-6 col-lg-4 about-us-image">
        <div class="shadow-image left animate-on-scroll">
          <div class="shadow-image-wrap">
              <img src="/assets/img/work-weld-tech.webp"  data-i18n-attr="[alt]about.image.alt">
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-8">
        <div class="about-us-content">
          <p class="accent-text-block right">
            <b data-i18n="about.mission.title"></b> — <span data-i18n="about.mission.text"></span>
          </p>
          <h4 data-i18n="about.experience"></h4>
          <div class="about-us-buttons row align-items-center justify-content-end">
            <span class="arrow arrow-right arrow-dark animate-on-scroll"></span>
            <a href="#services" class="simple-button" data-i18n="common.buttons.services"></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('templates/features.ejs') %>

<%- include('templates/stuff.ejs') %>

<%- include('templates/services.ejs') %>

<section class="home-slider">
  <div class="splide">
    <div class="splide__track">
      <ul class="splide__list">
         <li class="splide__slide"><img src="/assets/img/gallery/all/metal-constructions-1.webp"  data-i18n-attr="[alt]gallery.alt.metalConstructions"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/huge-pipelines.webp"  data-i18n-attr="[alt]gallery.alt.hugePipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_1414.webp"  data-i18n-attr="[alt]gallery.alt.industrialEquipment"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_1415.webp"  data-i18n-attr="[alt]gallery.alt.industrialEquipment"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_1504.webp"  data-i18n-attr="[alt]gallery.alt.pipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_1696.webp"  data-i18n-attr="[alt]gallery.alt.pipelineWork"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2073.webp"  data-i18n-attr="[alt]gallery.alt.capacitiveEquipment"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2077.webp"  data-i18n-attr="[alt]gallery.alt.pipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2078.webp"  data-i18n-attr="[alt]gallery.alt.capacitiveEquipment"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2080.webp"  data-i18n-attr="[alt]gallery.alt.pipelineWork"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2200.webp"  data-i18n-attr="[alt]gallery.alt.pipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/photo_2023-09-19_21-25-44.webp"  data-i18n-attr="[alt]gallery.alt.hugePipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/photo_2023-09-26_14-58-16.webp"  data-i18n-attr="[alt]gallery.alt.welder"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/pipelines2.webp"  data-i18n-attr="[alt]gallery.alt.pipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/pipelines-construction.webp"  data-i18n-attr="[alt]gallery.alt.pipelineConstruction"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/round-pipelines.webp"  data-i18n-attr="[alt]gallery.alt.curvedPipelines"></li>
         <li class="splide__slide"><img src="/assets/img/gallery/all/IMG_2075.webp"  data-i18n-attr="[alt]gallery.alt.pipelines"></li>
      </ul>
    </div>
  </div>

  <div class="container-md container-xxl h-100">
    <div class="row projects-bottom-text">
      <h4><b data-i18n="projects.bottom_text.part_1"></b> — <span data-i18n="projects.bottom_text.part_2"></span> <br>
          <span data-i18n="projects.bottom_text.part_3"></span></h4>
          <div class="btn-group">
            <a href="<%= path('projects/gallery-projects.html') %>" class="simple-button" data-i18n="projects.gallery_button"></a>
            <span class="arrow arrow-left arrow-dark animate-on-scroll"></span>
          </div>
    </div>
  </div>
</section>

<section id="work-stages" class="simple-section work-stages">
  <div class="container-md container-xxl h-100">
    <div class="simple-section__title dark">
      <h2 data-i18n="work-stages.title"></h2>
      <p class="accent-text-block all" data-i18n="work-stages.description"></p>
    </div>

    <%- include('templates/work-stages.ejs') %>

    <div class="btn-group group-center">
      <div class="btn-group-nowrap">
        <a href="<%= path('projects/projects.html') %>" class="simple-button" data-i18n="common.buttons.moreProjects"></a>
        <span class="arrow arrow-left arrow-dark animate-on-scroll"></span>
      </div>
      <div class="btn-group-nowrap">
        <span class="arrow arrow-right arrow-dark animate-on-scroll"></span>
        <a href="<%= path('projects/industry-solutions.html') %>" class="simple-button" data-i18n="common.buttons.industrySolutions"></a>
      </div>
    </div>
  </div>
</section>

<div class="video-bg">
    <video autoplay muted playsinline loop>
        <source src="/assets/video/video-promo.webm" type="video/webm">
        <source src="/assets//video/video-promo.mp4" type="video/mp4">
    </video>
</div>

<%- include('templates/certificates.ejs') %>

<%- include('templates/footer.ejs') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Weld Tech Group",
  "url": "<%= websiteUrl %>",
  "description": "<%= translations.home.meta.description %>",
  "logo": "<%= websiteUrl %>assets/img/logo-WTG.svg",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ul. Wileńska 31",
    "addressLocality": "Oleśnica",
    "postalCode": "56-400",
    "addressCountry": "PL"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+48510552446",
      "contactType": "customer service",
      "availableLanguage": ["Polish", "English", "Lithuanian", "German", "Ukrainian", "Russian", "Czech", "Spanish"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+48510552446",
      "contactType": "WhatsApp"
    },
    {
      "@type": "ContactPoint",
      "telephone": "+48510552446",
      "contactType": "Viber"
    },
    {
      "@type": "ContactPoint",
      "telephone": "@weld_tech_group",
      "contactType": "Telegram"
    }
  ],
  "email": "info@weld-tech.group",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "51.2088482",
    "longitude": "17.4086954"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "<%= websiteUrl %>",
    "name": "<%= translations.home.title %>",
    "description": "<%= translations.home.meta.description %>",
    "inLanguage": ["pl", "en", "lt", "de", "uk", "ru", "cs", "es"]
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Industrial Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= translations.services.items.pipelines.title %>",
          "url": "<%= websiteUrl %>services/installation-of-process-pipelines.html"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= translations.services.items.equipment.title %>",
          "url": "<%= websiteUrl %>services/equipment-for-industry.html"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= translations.services.items.capacitive.title %>",
          "url": "<%= websiteUrl %>services/production-of-capacitive-equipment.html"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= translations.services.items.structures.title %>",
          "url": "<%= websiteUrl %>services/metal-structures-and-service-platforms.html"
        }
      }
    ]
  },
  "image": [
    "<%= websiteUrl %>assets/img/preview-img/WeldTechMain.jpg",
    "<%= websiteUrl %>assets/img/work-weld-tech.webp"
  ]
}

</script>
</body>
</html>