<!DOCTYPE html>

<html lang="pl">
<head>
    <title data-i18n="projects.title"></title>
    <meta name="description" data-i18n-attr="[content]projects.meta_description">
    <%- include('../templates/meta.ejs') %>
    
</head>
<body>
<%- include('../templates/header.ejs', { isInnerPage: true }) %>


<section class="simple-section projects-section">
    
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="projects.main_title"></h2>
            <p class="accent-text-block all" >
                <b data-i18n="projects.main_description.part_1"></b><br>
                <span data-i18n="projects.main_description.part_2"></span>
            </p>
        </div>

        <div class="projects">
            <div class="row projects-row">
                <div class="col-12 col-md-4 projects__title">
                    <svg class="icon">
                        <use xlink:href="#pipelines"></use>
                    </svg>
                    <h3 data-i18n="projects.sections.pipelines.title"></h3>
                </div>
                <div class="col-12 col-md-8 projects__text">
                    <ul class="accent-list">
                        <li>
                            <p data-i18n="projects.sections.pipelines.items.0"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.pipelines.items.1"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.pipelines.items.2"></p>
                        </li>
                    </ul>
                </div>
            </div> 
            <div class="row projects-row">
                <div class="col-12 col-md-4 projects__title">
                    <svg class="icon icon-equipment">
                        <use xlink:href="#industry-equipment"></use>
                    </svg>
                    <h3 data-i18n="projects.sections.conveyors.title"></h3>
                </div>
                <div class="col-12 col-md-8 projects__text">
                    <ul class="accent-list">
                        <li>
                            <p data-i18n="projects.sections.conveyors.items.0"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.conveyors.items.1"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.conveyors.items.2"></p>
                        </li>
                    </ul>
                </div>
            </div> 
            <div class="row projects-row">
                <div class="col-12 col-md-4 projects__title">
                    <svg class="icon">
                        <use xlink:href="#capacitive-equipment"></use>
                    </svg>
                    <h3 data-i18n="projects.sections.tanks.title"></h3>
                </div>
                <div class="col-12 col-md-8 projects__text">
                    <ul class="accent-list">
                        <li>
                            <p data-i18n="projects.sections.tanks.items.0"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.tanks.items.1"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.tanks.items.2"></p>
                        </li>
                    </ul>
                </div>
            </div> 
            <div class="row projects-row">
                <div class="col-12 col-md-4 projects__title">
                    <svg class="icon">
                        <use xlink:href="#metal-structures"></use>
                    </svg>  
                    <h3 data-i18n="projects.sections.platforms.title"></h3>
                </div>
                <div class="col-12 col-md-8 projects__text">
                    <ul class="accent-list">
                        <li>
                            <p data-i18n="projects.sections.platforms.items.0"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.platforms.items.1"></p>
                        </li>
                        <li>
                            <p data-i18n="projects.sections.platforms.items.2"></p>
                        </li>
                    </ul>
                </div>
            </div> 
            <div class="row projects-bottom-text">
                <h4><b data-i18n="projects.bottom_text.part_1"></b> — <span data-i18n="projects.bottom_text.part_2"></span> <br>
                    <span data-i18n="projects.bottom_text.part_3"></span></h4>
                    <div class="btn-group">
                      <a href="<%= path('projects/gallery-projects.html') %>" class="simple-button" data-i18n="projects.gallery_button"></a>
                      <span class="arrow arrow-left arrow-dark animate-on-scroll"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="work-stages" class="simple-section work-stages light-image-bg projects-page-stages">
    <div class="container-md container-xxl h-100">
  
      <div class="simple-section__title dark border-bottom">
        <h2 data-i18n="projects.work_stages.title"></h2>
      </div>

      <%- include('../templates/work-stages.ejs') %>
    </div>
</section>

<section id="quality" class="simple-section quality">
    <div class="container-md container-xxl h-100">
      <div class="row">
        <div class="col-12 col-lg-4 quality-image">
  
          <div class="shadow-image left animate-on-scroll">
            <div class="shadow-image-wrap">
                <img src="/assets/img/IMG_2732.webp" alt="quality work">
            </div>
          </div>
  
        </div>
        <div class="col-12 col-lg-8">
          <div class="quality-content">
            <h3 class="simple-section__subtitle subtitle-right" data-i18n="projects.quality.title"></h3>
            <p class="accent-text-block right" >
                <span data-i18n="projects.quality.description.part_1"></span> <br><br>
                
                <span data-i18n="projects.quality.description.part_2"></span> <br><br>

                <span data-i18n="projects.quality.description.part_3"></span>
            </p>
            <div class="quality-buttons">
                <div class="btn-group row justify-content-end">
                    <span class="arrow arrow-right arrow-dark animate-on-scroll"></span>
                    <a href="<%= path('projects/our-equipment.html') %>" class="simple-button" data-i18n="projects.quality.equipment_button"></a>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<section class="simple-section know-more dark-image-bg accent-section-borders">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title light border-bottom">
            <h2 data-i18n="projects.advantages.title"></h2>
        </div>
        <div class="row">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#globe"></use>
                      </svg>
                    <h4 data-i18n="projects.advantages.international.title"></h4>
                    <p data-i18n="projects.advantages.international.description"></p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#road"></use>
                      </svg>
                    <h4 data-i18n="projects.advantages.flexibility.title"></h4>
                    <p data-i18n="projects.advantages.flexibility.description"></p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#quality-certificate-yellow"></use>
                      </svg>
                    <h4 data-i18n="projects.advantages.standards.title"></h4>
                    <p data-i18n="projects.advantages.standards.description"></p> 
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#mechanic-yellow"></use>
                      </svg>
                    <h4 data-i18n="projects.advantages.technology.title"></h4>
                    <p data-i18n="projects.advantages.technology.description"></p>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../templates/footer.ejs') %>

</body>
</html>