<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="our-equipment.title"></title>
    <meta name="description" data-i18n-attr="[content]our-equipment.meta_description">
    <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]our-equipment.title">
    <meta property="og:description" data-i18n-attr="[content]our-equipment.meta_description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMetalServices.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">
      
    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]our-equipment.title">
    <meta name="twitter:description" data-i18n-attr="[content]our-equipment.meta_description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMetalServices.jpg">
    <%- include('../templates/meta.ejs') %>
    
</head>
<body>
<%- include('../templates/header.ejs' , { isInnerPage: true }) %>

<section class="simple-section">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="our-equipment.main_title"></h2>
            <p class="accent-text-block all" data-i18n="our-equipment.main_description"></p>
        </div>
        <div class="tabs tabs-gallery our-equipment-tabs">
            <div class="tabs-btn-wrap">
                <button class="tabs-btn tabs-accent-btn active" data-tab="tab1"><h4 data-i18n="our-equipment.tabs.welding"></h4></button>
                <button class="tabs-btn tabs-accent-btn" data-tab="tab2"><h4 data-i18n="our-equipment.tabs.machining"></h4></button>
                <button class="tabs-btn tabs-accent-btn" data-tab="tab3"><h4 data-i18n="our-equipment.tabs.weld_preparation"></h4></button>
                <button class="tabs-btn tabs-accent-btn" data-tab="tab4"><h4 data-i18n="our-equipment.tabs.quality_control"></h4></button>
                <button class="tabs-btn tabs-accent-btn" data-tab="tab5"><h4 data-i18n="our-equipment.tabs.lifting"></h4></button>
            </div>
            <div class="tabs-content tabs-accent-content active" id="tab1">
                <h3 data-i18n="our-equipment.sections.welding.title"></h3>
                <ul class="accent-list">
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.welding.tig.title"></h4>
                            <p data-i18n="our-equipment.sections.welding.tig.description"></p>
                            <ul class="simple-list">
                                <li>
                                    <p data-i18n="our-equipment.sections.welding.tig.manual"></p> 
                                </li>
                                <li>
                                    <p data-i18n="our-equipment.sections.welding.tig.orbital"></p>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.welding.mig.title"></h4>
                            <p data-i18n="our-equipment.sections.welding.mig.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.welding.mma.title"></h4>
                            <p data-i18n="our-equipment.sections.welding.mma.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.welding.oxy.title"></h4>
                            <p data-i18n="our-equipment.sections.welding.oxy.description"></p>
                        </div>
                    </li>
                </ul>  
            </div>
            <div class="tabs-content tabs-accent-content" id="tab2">
                <h3 data-i18n="our-equipment.sections.machining.title"></h3>
                <ul class="accent-list">
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.machining.cnc.title"></h4>
                            <p data-i18n="our-equipment.sections.machining.cnc.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.machining.lathes.title"></h4>
                            <p data-i18n="our-equipment.sections.machining.lathes.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.machining.bending.title"></h4>
                            <p data-i18n="our-equipment.sections.machining.bending.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.machining.drilling.title"></h4>
                            <p data-i18n="our-equipment.sections.machining.drilling.description"></p>
                        </div>
                    </li>
                </ul>  
            </div>
            <div class="tabs-content tabs-accent-content" id="tab3">
                <h3 data-i18n="our-equipment.sections.weld_preparation.title"></h3>
                <ul class="accent-list">
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.weld_preparation.grinding.title"></h4>
                            <p data-i18n="our-equipment.sections.weld_preparation.grinding.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.weld_preparation.passivation.title"></h4>
                            <p data-i18n="our-equipment.sections.weld_preparation.passivation.description"></p>
                        </div>
                    </li>
                </ul> 
            </div>
            <div class="tabs-content tabs-accent-content" id="tab4">
                <h3 data-i18n="our-equipment.sections.quality_control.title"></h3>
                <ul class="accent-list">
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.quality_control.ndt.title"></h4>
                            <ul class="simple-list">
                                <li>
                                    <p data-i18n="our-equipment.sections.quality_control.ndt.ultrasonic"></p> 
                                </li>
                                <li>
                                    <p data-i18n="our-equipment.sections.quality_control.ndt.radiographic"></p>
                                </li>
                                <li>
                                    <p data-i18n="our-equipment.sections.quality_control.ndt.penetrant"></p>
                                </li>
                                <li>
                                    <p data-i18n="our-equipment.sections.quality_control.ndt.magnetic"></p>
                                </li>
                            </ul>
                            <br>
                            <p data-i18n="our-equipment.sections.quality_control.ndt.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.quality_control.measuring.title"></h4>
                            <p data-i18n="our-equipment.sections.quality_control.measuring.description"></p>
                        </div>
                    </li>
                </ul>  
            </div>
            <div class="tabs-content tabs-accent-content" id="tab5">
                <h3 data-i18n="our-equipment.sections.lifting.title"></h3>
                <ul class="accent-list">
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.lifting.cranes.title"></h4>
                            <p data-i18n="our-equipment.sections.lifting.cranes.description"></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h4 data-i18n="our-equipment.sections.lifting.forklifts.title"></h4>
                            <p data-i18n="our-equipment.sections.lifting.forklifts.description"></p>
                        </div>
                    </li>
                </ul>  
            </div>
        </div>
    </div>
</section>

<section class="simple-section know-more our-equipment dark-image-bg accent-section-borders">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title light border-bottom">
            <h2 data-i18n="our-equipment.why_important.title"></h2>
        </div>
        <div class="row">
            <div class="col-12 col-md-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#caliper"></use>
                      </svg>
                    <h4 data-i18n="[html]our-equipment.why_important.precision.title"></h4>
                    <p data-i18n="our-equipment.why_important.precision.description"></p>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#rocket"></use>
                      </svg>
                    <h4 data-i18n="[html]our-equipment.why_important.speed.title"></h4>
                    <p data-i18n="our-equipment.why_important.speed.description"></p>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#road"></use>
                      </svg>
                    <h4 data-i18n="[html]our-equipment.why_important.flexibility.title"></h4>
                    <p data-i18n="our-equipment.why_important.flexibility.description"></p> 
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="know-more-item">
                    <svg class="icon">
                        <use xlink:href="#process"></use>
                      </svg>
                    <h4 data-i18n="[html]our-equipment.why_important.full_cycle.title"></h4>
                    <p data-i18n="our-equipment.why_important.full_cycle.description"></p>
                </div>
            </div>
            
        </div>
    </div>
</section>

<%- include('../templates/footer.ejs') %>

</body>
</html>