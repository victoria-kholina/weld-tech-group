<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="capacitive-equipment.title"></title>
    <%- include('../templates/meta.ejs') %>
    <meta name="description" data-i18n-attr="[content]capacitive-equipment.meta_description">
    <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]capacitive-equipment.title">
    <meta property="og:description" data-i18n-attr="[content]capacitive-equipment.meta_description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechCapacitiveEquipment.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">
   
    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]capacitive-equipment.title">
    <meta name="twitter:description" data-i18n-attr="[content]capacitive-equipment.meta_description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechCapacitiveEquipment.jpg">
</head>
<body>
<%- include('../templates/header.ejs') %>

<section class="simple-section service-page light-bg capacitive-equipmant">
    <div class="container-md container-xxl h-100">
        <div class="container-md container-xxl h-100">
            <div class="simple-section__title dark">
                <h2 data-i18n="capacitive-equipment.main_title"></h2>
                <p class="accent-text-block all" data-i18n="capacitive-equipment.main_description"></p>
            </div>
        </div>
        <div class="row service-page-info-wrap">
            <div class="col-12 col-md-10 offset-md-1">
                <div class="service-page-info">
                    <div class="gradient-border bottom">
                        <ul class="accent-list">
                            <li>
                                <h5 data-i18n="capacitive-equipment.volume.title"></h5>
                            </li>
                            <li>
                                <h5 data-i18n="capacitive-equipment.custom.title"></h5>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="service-page-info">
                    <h3 class="service-page-info__title" data-i18n="capacitive-equipment.materials.title"></h3>
                    <ul class="simple-list">
                        <li>
                            <p data-i18n="capacitive-equipment.materials.stainless"></p>
                        </li>
                        <li>
                            <p data-i18n="capacitive-equipment.materials.carbon"></p>
                        </li>
                        <li>
                            <p data-i18n="capacitive-equipment.materials.aluminum"></p>
                        </li>
                        <li>
                            <p data-i18n="capacitive-equipment.materials.titanium"></p>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6 gradient-border left">
                <div class="service-page-info">
                    <h3 class="service-page-info__title" data-i18n="capacitive-equipment.environments.title"></h3>
                    <ul class="simple-list">
                        <li>
                            <p data-i18n="capacitive-equipment.environments.liquids"></p>
                        </li>
                        <li>
                            <p data-i18n="capacitive-equipment.environments.bulk"></p>
                        </li>
                        <li>
                            <p data-i18n="capacitive-equipment.environments.chemicals"></p>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="col-12 service-page-bottom">
                <h4 data-i18n="capacitive-equipment.bottom_description"></h4>
            </div>
        </div>
    </div>
</section>

<section class="simple-section simple-gallery">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="capacitive-equipment.realisations.title"></h2>
            <p class="accent-text-block all" data-i18n="capacitive-equipment.realisations.description"></p>
        </div>
        <%- include('../templates/gallery-capacitive-equipmaint.ejs') %>
    </div>
</section>

<%- include('../templates/know-more.ejs') %>

<%- include('../templates/footer.ejs') %>

</body>
</html>