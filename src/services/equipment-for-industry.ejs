<!DOCTYPE html>

<html lang="pl">
<head>
    <title data-i18n="equipment.title"></title>
    <meta name="description" data-i18n-attr="[content]equipment.meta_description">
    <%- include('../templates/meta.ejs') %>
</head>
<body>
<%- include('../templates/header.ejs' ) %>

<section class="simple-section service-page light-image-bg">
    <div class="container-md container-xxl h-100">
        <div class="container-md container-xxl h-100">
            <div class="simple-section__title dark">
                <h2 data-i18n="equipment.main_title"></h2>
                <p class="accent-text-block all" data-i18n="equipment.main_description"></p>
            </div>
        </div>
        <div class="row service-page-info-wrap">
            <div class="col-12 col-md-6">
                <div class="service-page-info">
                    <ul class="accent-list">
                        <li>
                            <div>
                                <h5 data-i18n="equipment.conveyors.title"></h5>
                                <p data-i18n="equipment.conveyors.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="equipment.bridges.title"></h5>
                                <p data-i18n="equipment.bridges.description"></p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6 gradient-border left">
                <div class="service-page-info">
                    <ul class="accent-list">
                        <li>
                            <div>
                                <h5 data-i18n="equipment.storage.title"></h5>
                                <p data-i18n="equipment.storage.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="equipment.loading.title"></h5>
                                <p data-i18n="equipment.loading.description"></p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="col-12 service-page-bottom">
                <h4 data-i18n="equipment.production.description"></h4>
            </div>
        </div>
    </div>
</section>

<section class="simple-section simple-gallery">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="equipment.realisations.title"></h2>
            <p class="accent-text-block all" data-i18n="equipment.realisations.description"></p>
        </div>
        <%- include('../templates/gallery-all.ejs') %>
    </div>
</section>

<%- include('../templates/know-more.ejs') %>

<%- include('../templates/footer.ejs') %>

</body>
</html>