<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="metal-structures.title"></title>
    <%- include('../templates/meta.ejs') %>
    <meta name="description" data-i18n-attr="[content]metal-structures.meta_description">
       <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]metal-structures.title">
    <meta property="og:description" data-i18n-attr="[content]metal-structures.meta_description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMetalStructures.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">
      
    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]metal-structures.title">
    <meta name="twitter:description" data-i18n-attr="[content]metal-structures.meta_description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechMetalStructures.jpg">
</head>
<body>
<%- include('../templates/header.ejs') %>

<section class="simple-section service-page light-bg">
    <div class="container-md container-xxl h-100">
        <div class="container-md container-xxl h-100">
            <div class="simple-section__title dark">
                <h2 data-i18n="metal-structures.main_title"></h2>
                <p class="accent-text-block all" data-i18n="metal-structures.main_description"></p>
            </div>
        </div>
        <div class="row service-page-info-wrap">
            <div class="col-12">
                <div class="service-page-info">
                    <h3 class="service-page-info__title" data-i18n="metal-structures.materials.title"></h3>
                    <ul class="accent-list">
                        <li>
                            <div>
                                <h5 data-i18n="metal-structures.materials.steel.title"></h5>
                                <p data-i18n="metal-structures.materials.steel.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="metal-structures.materials.aluminum.title"></h5>
                                <p data-i18n="metal-structures.materials.aluminum.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="metal-structures.materials.stainless.title"></h5>
                                <p data-i18n="metal-structures.materials.stainless.description"></p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="col-12 service-page-bottom">
                <h4 data-i18n="metal-structures.bottom_description"></h4>
            </div>
        </div>
    </div>
</section>

<section class="simple-section simple-gallery">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="metal-structures.realisations.title"></h2>
            <p class="accent-text-block all" data-i18n="metal-structures.realisations.description"></p>
        </div>
        <%- include('../templates/gallery-all.ejs') %>
    </div>
</section>

<%- include('../templates/know-more.ejs') %>

<%- include('../templates/footer.ejs') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "<%= translations['metal-structures'].title %>",
  "description": "<%= translations['metal-structures'].main_description %>",
  "url": "<%= websiteUrl %>services/metal-structures-and-service-platforms.html",
  "provider": {
    "@type": "Organization",
    "name": "Weld Tech Group",
    "url": "<%= websiteUrl %>"
  },
  "serviceType": "Metal Structures Manufacturing"
}
</script>

</body>
</html>