<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="pipelines.title"></title>
    <%- include('../templates/meta.ejs') %>
    <meta name="description" data-i18n-attr="[content]pipelines.meta_description">
    <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]pipelines.title">
    <meta property="og:description" data-i18n-attr="[content]pipelines.meta_description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechPipelines.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">
   
    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]pipelines.title">
    <meta name="twitter:description" data-i18n-attr="[content]pipelines.meta_description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechPipelines.jpg">
</head>
<body>
<%- include('../templates/header.ejs') %>


<section class="simple-section service-page light-bg">
    <div class="container-md container-xxl h-100">
        <div class="container-md container-xxl h-100">
            <div class="simple-section__title dark">
                <h2 data-i18n="pipelines.main_title"></h2>
                <p class="accent-text-block all" data-i18n="pipelines.main_description"></p>
            </div>
        </div>
        <div class="row service-page-info-wrap">
            <div class="col-12 col-md-6">
                <div class="service-page-info">

                    <h3 class="service-page-info__title" data-i18n="pipelines.welding_technologies.title"></h3>
                    <ul class="accent-list">
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.welding_technologies.tig.title"></h5>
                                <p data-i18n="pipelines.welding_technologies.tig.diameter"></p>
                                <p data-i18n="pipelines.welding_technologies.tig.thickness"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.welding_technologies.orbital.title"></h5>
                                <p data-i18n="pipelines.welding_technologies.orbital.diameter"></p>
                                <p data-i18n="pipelines.welding_technologies.orbital.thickness"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.welding_technologies.mma.title"></h5>
                                <p data-i18n="pipelines.welding_technologies.mma.description"></p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6 gradient-border left">
                <div class="service-page-info">
                    <h3 class="service-page-info__title" data-i18n="pipelines.wall_thickness.title"></h3>
                    <ul class="accent-list">
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.wall_thickness.thin.title"></h5>
                                <p data-i18n="pipelines.wall_thickness.thin.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.wall_thickness.medium.title"></h5>
                                <p data-i18n="pipelines.wall_thickness.medium.description"></p>
                            </div>
                        </li>
                        <li>
                            <div>
                                <h5 data-i18n="pipelines.wall_thickness.thick.title"></h5>
                                <p data-i18n="pipelines.wall_thickness.thick.description"></p>
                            </div>
                        </li>
                    </ul>
                </div>
                
            </div>
            
            <div class="col-12 service-page-bottom">
                <h4 data-i18n="pipelines.bottom_description"></h4>
            </div>
        </div>
    </div>
</section>

<section class="simple-section simple-gallery">
    <div class="container-md container-xxl h-100">
        <div class="simple-section__title dark">
            <h2 data-i18n="pipelines.realisations.title"></h2>
            <p class="accent-text-block all" data-i18n="pipelines.realisations.description"></p>
        </div>
        <%- include('../templates/gallery-instalation-pipelines.ejs') %>
    </div>
    
</section>

<%- include('../templates/know-more.ejs') %>

<%- include('../templates/footer.ejs') %>

</body>
</html>