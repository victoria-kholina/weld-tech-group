<section id="certificates" class="simple-section certificate accent-section-borders">
    <div class="container-md container-xxl h-100">
      <div class="simple-section__title light border-bottom">
        <h2 data-i18n="certificates.title"></h2>
      </div>
      <div class="row certificate-row">
        <div class="col-12 col-md-6">
          <div class="row flex-column align-items-center">
            <h2 class="certificate-name zoom-In animate-on-scroll">ISO 3834 – 2</h2>
            <h5 class="certificate-text" data-i18n="certificates.iso.description"></h5>
            <img src="../src/assets/img/EN-ISO-3834-2.webp" class="certificate-image open-modal" data-i18n-attr="[alt]certificates.iso.imageAlt" data-type="pdf" data-src="../assets/img/pdf/EN-ISO-3834-2-ENG.pdf">
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="row flex-column align-items-center">
             <h2 class="certificate-name zoom-In animate-on-scroll">EN 1090-1034</h2>
              <h5 class="certificate-text" data-i18n="certificates.en.description"></h5>
              <img src="../src/assets/img/1090-1034.webp" class="certificate-image open-modal" data-i18n-attr="[alt]certificates.en.imageAlt" data-type="pdf" data-src="../assets/img/pdf/EN-1090-ENG.pdf">
          </div>
        </div>
      </div>
    </div>
  </section>