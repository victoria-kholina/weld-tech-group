<!DOCTYPE html>

<html lang="<%= lang %>">
<head>
    <title data-i18n="services.title"></title>
    <meta name="description" data-i18n-attr="[content]services.meta.description">
    <!-- Open Graph -->
    <meta property="og:title" data-i18n-attr="[content]services.title">
    <meta property="og:description" data-i18n-attr="[content]services.meta.description">
    <meta property="og:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechServices.jpg">
    <meta property="og:locale" content="<%= lang %>_<%= lang.toUpperCase() %>">

    <!-- Twitter Card -->
    <meta name="twitter:title" data-i18n-attr="[content]services.title">
    <meta name="twitter:description" data-i18n-attr="[content]services.meta.description">
    <meta name="twitter:image" content="<%= websiteUrl %>assets/img/preview-img/WeldTechServices.jpg">
    
    <%- include('templates/meta.ejs') %>
    
</head>
<body>
<%- include('templates/header.ejs') %>

<%- include('templates/services.ejs') %>

  <section class="simple-section">
    <div class="container-md container-xxl h-100">
        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="services-experiance">
                    <h3 class="simple-section__subtitle subtitle-left" data-i18n="services.experience.title"></h3>
                    <div class="accent-text-block left">
                        <p data-i18n="services.experience.description"></p>
                        <h4 class="simple-section__subtitle" data-i18n="services.methods.title"></h4>
                        <div class="row">
                            <div class="col-12 col-md-6">
                                <ul class="accent-list">
                                    <li><p data-i18n="services.methods.list1.tig"></p></li>
                                    <li><p data-i18n="services.methods.list1.mig"></p></li>
                                    <li><p data-i18n="services.methods.list1.tigElectrode"></p></li>
                                    <li><p data-i18n="services.methods.list1.electrode"></p></li>
                                    <li><p data-i18n="services.methods.list1.oxyacetylene"></p></li>
                                </ul>
                            </div>
                            <div class="col-12 col-md-6">
                                <ul class="accent-list">
                                    <li><p data-i18n="services.methods.list2.softSoldering"></p></li>
                                    <li><p data-i18n="services.methods.list2.hardSoldering"></p></li>
                                    <li><p data-i18n="services.methods.list2.planing"></p></li>
                                    <li><p data-i18n="services.methods.list2.plasmaCutting"></p></li>
                                    <li><p data-i18n="services.methods.list2.arcPlasmaCutting"></p></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="shadow-image left animate-on-scroll">
                    <div class="shadow-image-wrap">
                        <img src="/assets/img/IMG_1129.webp" data-i18n-attr="[alt]services.image.alt">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<%- include('templates/features.ejs') %>
<%- include('templates/footer.ejs') %>

</body>
</html>